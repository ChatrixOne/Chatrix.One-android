<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application android:icon="@mipmap/new_launcher">
        <activity
            android:name=".ui.ManageAccountActivity"
            android:label="@string/title_activity_manage_accounts"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Conversations3" />
        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <!-- Chatrix.One: "Open Chatrix.One" on the chatrix.one sign-up success page -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="login"
                    android:scheme="chatrixone" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.PickServerActivity"
            android:enableOnBackInvokedCallback="false"
            android:label="@string/create_new_account"
            android:launchMode="singleTask"
            tools:targetApi="33" />
        <activity
            android:name=".ui.MagicCreateActivity"
            android:label="@string/create_new_account"
            android:launchMode="singleTask" />
        <activity
            android:name=".ui.EasyOnboardingInviteActivity"
            android:label="@string/server_invite"
            android:launchMode="singleTask" />
    </application>
</manifest>
